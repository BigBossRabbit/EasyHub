   155|   155|   155|          },
   156|   156|   156|          body: JSON.stringify({
   157|   157|   157|            name: formData.name,
   158|   158|   158|            email: formData.email,
   159|   159|   159|            signupNumber: result.signup_number,
   160|   160|   160|            isWaitingList: result.is_waiting_list,
   161|   161|   161|          }),
   162|   162|   162|        });
   163|   163|   163|        if (emailResponse.ok) {
   164|   164|   164|          setEmailSent(true);
   165|   165|   165|        }
   166|   166|   166|      } catch {
