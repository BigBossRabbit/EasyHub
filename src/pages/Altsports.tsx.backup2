   392|   391|   391|                        <Timer className="h-12 w-12 text-yellow-400 animate-pulse" />
   393|   392|   392|                      </div>
   394|   393|   393|                      <h2 className="text-3xl sm:text-4xl font-black text-yellow-400">Waiting List</h2>
   395|   394|   394|                      <div className="py-4">
   396|   395|   395|                        <div className="relative inline-block">
   397|   396|   396|                          <p className="text-7xl sm:text-8xl md:text-9xl font-black font-mono text-yellow-400 tabular-nums">
   398|   397|   397|                            #{signupNumber}
   399|   398|   398|                          </p>
   400|   399|   399|                          <div className="absolute -top-3 -right-6">
   401|   400|   400|                            <Crown className="h-8 w-8 text-yellow-400 rotate-12" />
   402|   401|   401|                          </div>
   403|   402|   402|                        </div>
   404|   403|   403|                        <p className="text-sm text-muted-foreground mt-2 font-mono font-bold">Your Sign-Up Number</p>
   405|   404|   404|                      </div>
   406|   405|   405|                      <div className="bg-yellow-500/10 border border-yellow-500/20 rounded-xl p-4 max-w-md mx-auto backdrop-blur-sm">
   407|   406|   406|                        <p className="text-sm text-yellow-200 leading-relaxed">
   408|   407|   407|                          All <strong>{MAX_SPOTS}</strong> tournament spots are currently claimed. You're on the <strong className="text-yellow-400">waiting list</strong>.
   409|   408|   408|                          Open spots go to waitlisted players who show up!
   410|   409|   409|                        </p>
   411|   410|   410|                      </div>
   412|   411|   411|                    </>
   413|   412|   412|                  ) : (
   414|   413|   413|                    <>
   415|   414|   414|                      <div className="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-br from-primary/20 to-yellow-500/20 border-2 border-primary/30 relative">
   416|   415|   415|                        <Sparkles className="h-12 w-12 text-primary" />
   417|   416|   416|                        <div className="absolute inset-0 rounded-full border-2 border-primary/20 animate-ping" style={{ animationDuration: "3s" }} />
   418|   417|   417|                      </div>
   419|   418|   418|                      <h2 className="text-3xl sm:text-4xl font-black">
   420|   419|   419|                        <span className="bg-gradient-to-r from-primary via-yellow-400 to-primary bg-clip-text text-transparent">
   421|   420|   420|                          You're In! 🎉
   422|   421|   421|                        </span>
   423|   422|   422|                      </h2>
   424|   423|   423|                      <div className="py-4">
   425|   424|   424|                        <div className="relative inline-block">
   426|   425|   425|                          <p className="text-8xl sm:text-9xl font-black font-mono text-primary tabular-nums">
   427|   426|   426|                            #{signupNumber}
   428|   427|   427|                          </p>
   429|   428|   428|                          <div className="absolute -top-4 -right-8 animate-bounce" style={{ animationDuration: "1.5s" }}>
   430|   429|   429|                            <Star className="h-10 w-10 text-yellow-400 fill-yellow-400" />
   431|   430|   430|                          </div>
   432|   431|   431|                        </div>
   433|   432|   432|                        <p className="text-sm text-muted-foreground mt-2 font-mono font-bold">
   434|   433|   433|                          Your Sign-Up Number — <span className="text-yellow-400">of {MAX_SPOTS}</span>
   435|   434|   434|                        </p>
   436|   435|   435|                      </div>
   437|   436|   436|                      <div className="bg-primary/10 border border-primary/20 rounded-xl p-4 max-w-md mx-auto backdrop-blur-sm">
   438|   437|   437|                        <p className="text-sm text-primary-foreground/80 leading-relaxed">
   439|   438|   438|                          <strong>🔐 Save your sign-up number!</strong> You'll need it on tournament day.
   440|   439|   439|                          Payment deadline: <strong className="text-red-400">1:00 PM, 23 May 2026</strong>
   441|   440|   440|                        </p>
   442|   441|   441|                      </div>
   443|   442|   442|                      <div className="bg-red-500/10 border border-red-500/20 rounded-xl p-4 max-w-md mx-auto">
   444|   443|   443|                        <p className="text-sm text-red-300 leading-relaxed">
   445|   444|   444|                          <strong>⚠️ Important:</strong> If you haven't paid by the deadline, your spot goes to the waiting list.
   446|   445|   445|                        </p>
   447|   446|   446|                      </div>
   448|   447|   447|                    </>
   449|   448|   448|                  )}
