   351|   351|   351|          {/* Event Details */}
   352|   352|   352|          <Card className="border border-border/50 bg-card/80 backdrop-blur-sm mb-8 overflow-hidden">
   353|   353|   353|            <div className="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-primary/50 to-transparent" />
   354|   354|   354|            <CardContent className="p-5 sm:p-6">
   355|   355|   355|              <div className="flex items-center gap-2 mb-5">
   356|   356|   356|                <Calendar className="h-5 w-5 text-primary" />
   357|   357|   357|                <h3 className="text-lg font-bold">Event Details</h3>
   358|   358|   358|              </div>
   359|   359|   359|              <div className="grid sm:grid-cols-2 gap-3">
   360|   360|   360|                {[
   361|   361|   361|                  { icon: Calendar, label: "Date", value: "Saturday, 23 May 2026", color: "text-primary" },
   362|   362|   362|                  { icon: Clock, label: "Payment Deadline", value: "1:00 PM — 23 May 2026", color: "text-yellow-400" },
   { icon: Zap, label: "Entry Fee", value: "N$100 cash will be converted into Bitcoin for you to pay in‑venue with the Primal App https://primal.net/downloads", color: "text-primary" },
   { icon: Zap, label: "Wallet Options", value: "Blink https://www.blink.sv/ or Aqua https://aqua.net/. We recommend downloading all.", color: "text-primary" },
   364|   { icon: Zap, label: "Wallet Options", value: "Blink https://www.blink.sv/ or Aqua https://aqua.net/. We recommend downloading all.", color: "text-primary" },
   365|   364|   364|                  { icon: Trophy, label: "Format", value: `Pool Tournament — ${MAX_SPOTS} Players`, color: "text-primary" },
   366|   365|   365|                  { icon: Crosshair, label: "Entry Rule", value: `First ${MAX_SPOTS} sign-ups only`, color: "text-red-400" },
   367|   366|   366|                ].map((item) => (
   368|   367|   367|                  <div key={item.label} className="group flex items-start gap-3 bg-muted/5 rounded-xl p-4 border border-border/30 hover:border-primary/30 transition-all duration-300 hover:bg-muted/10">
   369|   368|   368|                    <div className={`p-2 rounded-lg bg-muted/20 ${item.color} group-hover:scale-110 transition-transform`}>
   370|   369|   369|                      <item.icon className="h-4 w-4" />
   371|   370|   370|                    </div>
   372|   371|   371|                    <div>
   373|   372|   372|                      <p className="font-bold text-xs uppercase tracking-wider text-muted-500">{item.label}</p>
   374|   373|   373|                      <p className={`text-sm font-semibold ${item.color}`}>{item.value}</p>
   375|   374|   374|                    </div>
   376|   375|   375|                  </div>
   377|   376|   376|                ))}
   378|   377|   377|              </div>
   379|   378|   378|            </CardContent>
   380|   379|   379|          </Card>
   381|   380|   380|
   382|   381|   381|          {/* After Submission: Sign-Up Number Display */}
   383|   382|   382|          {submitted && signupNumber !== null && (
