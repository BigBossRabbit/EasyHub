   452|   451|   451|                  {emailSent && (
   453|   452|   452|                    <div className="bg-green-500/10 border border-green-500/20 rounded-xl p-4 max-w-md mx-auto">
   454|   453|   453|                      <p className="text-sm text-green-300 leading-relaxed">
   455|   454|   454|                        <strong>📧 Confirmation email sent!</strong> Check your inbox for your sign-up details.
   456|   455|   455|                      </p>
   457|   456|   456|                    </div>
   458|   457|   457|                  )}
   459|   458|   458|
   460|   459|   459|                  <div className="pt-4">
   461|   460|   460|                    <Button onClick={resetForm} variant="outline" className="border-border hover:bg-muted font-mono text-sm px-8 py-2">
   462|   461|   461|                      ← Submit Another Entry
   463|   462|   462|                    </Button>
   464|   463|   463|                  </div>
   465|   464|   464|                </CardContent>
   466|   465|   465|              </Card>
   467|   466|   466|            </div>
   468|   467|   467|          )}
