   493|   492|   492|                    <div className="space-y-2 group">
   494|   493|   493|                      <label htmlFor="name" className="text-xs font-black flex items-center gap-2 uppercase tracking-wider text-muted-foreground group-focus-within:text-primary transition-colors">
   495|   494|   494|                        <User className="h-4 w-4" />
   496|   495|   495|                        Full Name
   497|   496|   496|                      </label>
   498|   497|   497|                      <input
   499|   498|   498|                        type="text"
   500|   499|   499|                        id="name"
   501|