     8|     8|     8|const MAX_SPOTS = 64;
     9|     9|     9|
    10|    10|    10|// Confetti particle component
    11|    11|    11|const Confetti = ({ active }: { active: boolean }) => {
    12|    12|    12|  if (!active) return null;
    13|    13|    13|  const particles = Array.from({ length: 50 }, (_, i) => ({
    14|    14|    14|    id: i,
    15|    15|    15|    left: Math.random() * 100,
    16|    16|    16|    delay: Math.random() * 2,
    17|    17|    17|    duration: 2 + Math.random() * 3,
    18|    18|    18|    color: ["#FF7000", "#FFD700", "#FFA500", "#FF4500", "#FFFF00", "#00FF00"][Math.floor(Math.random() * 6)],
    19|    19|    19|    size: 4 + Math.random() * 8,
    20|    20|    20|    rotation: Math.random() * 360,
    21|    21|    21|  }));
    22|    22|    22|
    23|    23|    23|  return (
    24|    24|    24|    <div className="fixed inset-0 pointer-events-none z-50 overflow-hidden">
    25|    25|    25|      {particles.map((p) => (
    26|    26|    26|        <div
    27|    27|    27|          key={p.id}
    28|    28|    28|          className="absolute animate-confetti-fall"
    29|    29|    29|          style={{
    30|    30|    30|            left: `${p.left}%`,
    31|    31|    31|            top: "-10px",
    32|    32|    32|            width: `${p.size}px`,
    33|    33|    33|            height: `${p.size}px`,
    34|    34|    34|            backgroundColor: p.color,
    35|    35|    35|            borderRadius: Math.random() > 0.5 ? "50%" : "2px",
    36|    36|    36|            transform: `rotate(${p.rotation}deg)`,
    37|    37|    37|            animationDelay: `${p.delay}s`,
    38|    38|    38|            animationDuration: `${p.duration}s`,
    39|    39|    39|          }}
    40|    40|    40|        />
    41|    41|    41|      ))}
    42|    42|    42|    </div>
    43|    43|    43|  );
    44|    44|    44|};
    45|    45|    45|
    46|    46|    46|// Animated counter
    47|    47|    47|const AnimatedNumber = ({ value, className }: { value: number; className?: string }) => {
    48|    48|    48|  const [display, setDisplay] = useState(0);
    49|    49|    49|  useEffect(() => {
    50|    50|    50|    const duration = 800;
    51|    51|    51|    const steps = 20;
    52|    52|    52|    const increment = value / steps;
    53|    53|    53|    let current = 0;
    54|    54|    54|    const timer = setInterval(() => {
    55|    55|    55|      current += increment;
    56|    56|    56|      if (current >= value) {
    57|    57|    57|        setDisplay(value);
    58|    58|    58|        clearInterval(timer);
    59|    59|    59|      } else {
    60|    60|    60|        setDisplay(Math.floor(current));
    61|    61|    61|      }
    62|    62|    62|    }, duration / steps);
    63|    63|    63|    return () => clearInterval(timer);
    64|    64|    64|  }, [value]);
    65|    65|    65|  return <span className={className}>{display}</span>;
    66|    66|    66|};
    67|    67|    67|
    68|    68|    68|const Altsports = () => {
    69|    69|    69|  const [formData, setFormData] = useState({ name: "", email: "", phone: "" });
    70|    70|    70|  const [submitted, setSubmitted] = useState(false);
    71|    71|    71|  const [signupNumber, setSignupNumber] = useState<number | null>(null);
    72|    72|    72|  const [totalSignups, setTotalSignups] = useState(0);
    73|    73|    73|  const [spotsRemaining, setSpotsRemaining] = useState(MAX_SPOTS);
    74|    74|    74|  const [isWaitingList, setIsWaitingList] = useState(false);
    75|    75|    75|  const [showConfetti, setShowConfetti] = useState(false);
    76|    76|    76|  const [loading, setLoading] = useState(false);
    77|    77|    77|  const [error, setError] = useState("");
    78|    78|    78|  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });
    79|    79|    79|  const [emailSent, setEmailSent] = useState(false);
    80|    80|    80|  const [supabaseActive, setSupabaseActive] = useState(false);
    81|    81|    81|
    82|    82|    82|  // Parallax mouse effect
    83|    83|    83|  const handleMouseMove = useCallback((e: React.MouseEvent) => {
    84|    84|    84|    const rect = e.currentTarget.getBoundingClientRect();
    85|    85|    85|    setMousePos({
    86|    86|    86|      x: ((e.clientX - rect.left) / rect.width - 0.5) * 20,
    87|    87|    87|      y: ((e.clientY - rect.top) / rect.height - 0.5) * 20,
    88|    88|    88|    });
    89|    89|    89|  }, []);
    90|    90|    90|
    91|    91|    91|  // Load stats from Supabase
    92|    92|    92|  const loadStats = useCallback(async () => {
    93|    93|    93|    try {
    94|    94|    94|      if (isSupabaseAvailable()) {
    95|    95|    95|        const stats = await getTournamentStats();
    96|    96|    96|        setTotalSignups(stats.totalSignups);
    97|    97|    97|        setSpotsRemaining(stats.spotsRemaining);
    98|    98|    98|        setSupabaseActive(true);
    99|    99|    99|      }
   100|   100|   100|    } catch {
   101|   101|   101|      // Supabase not ready yet, use defaults
   102|   102|   102|    }
   103|   103|   103|  }, []);
   104|   104|   104|
   105|   105|   105|  useEffect(() => {
   106|   106|   106|    loadStats();
   107|   107|   107|    const interval = setInterval(loadStats, 10000);
   108|   108|   108|    return () => clearInterval(interval);
   109|   109|   109|  }, [loadStats]);
   110|   110|   110|
   111|   111|   111|  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
   112|   112|   112|    const { name, value } = e.target;
   113|   113|   113|    setFormData((prev) => ({ ...prev, [name]: value }));
   114|   114|   114|    setError("");
   115|   115|   115|  };
   116|   116|   116|
   117|   117|   117|  const handleSubmit = async (e: React.FormEvent) => {
   118|   118|   118|    e.preventDefault();
   119|   119|   119|    setLoading(true);
   120|   120|   120|    setError("");
   121|   121|   121|    setEmailSent(false);
   122|   122|   122|
   123|   123|   123|    try {
   124|   124|   124|      if (!isSupabaseAvailable()) {
   125|   125|   125|        throw new Error("Database is not connected. Please try again later.");
   126|   126|   126|      }
   127|   127|   127|
   128|   128|   128|      // Validate Namibian phone number format: +2648xxxxxxxx
   129|   129|   129|      const phoneRegex = /^\+2648\d{8}$/;
   130|   130|   130|      if (!phoneRegex.test(formData.phone.trim())) {
   131|   131|   131|        throw new Error("Phone number must be in the format +2648xxxxxxxx (e.g. +264****5678)");
   132|   132|   132|      }
   133|   133|   133|
   134|   134|   134|      // Submit to Supabase — the DB assigns the signup number
   135|   135|   135|      const result = await submitTournamentSignup(formData.name, formData.email, formData.phone);
   136|   136|   136|
   137|   137|   137|      setSignupNumber(result.signup_number);
   138|   138|   138|      setIsWaitingList(result.is_waiting_list);
   139|   139|   139|      setSubmitted(true);
   140|   140|   140|
   141|   141|   141|      if (!result.is_waiting_list) {
   142|   142|   142|        setShowConfetti(true);
   143|   143|   143|        setTimeout(() => setShowConfetti(false), 4000);
   144|   144|   144|      }
   145|   145|   145|
   146|   146|   146|      // Send confirmation email via edge function
   147|   147|   147|      try {
   148|   148|   148|        const SUPABASE_URL = import.meta.env.VITE_SUPABASE_URL;
   149|   149|   149|        const SUPABASE_ANON_KEY = import.meta.env.VITE_SUPABASE_ANON_KEY;
   150|   150|   150|        const emailResponse = await fetch(`${SUPABASE_URL}/functions/v1/send-tournament-confirmation`, {
   151|   151|   151|          method: "POST",
   152|   152|   152|          headers: {
   153|   153|   153|            "Content-Type": "application/json",
