   476|   475|   475|                <div className="absolute top-3 right-3 text-[10px] font-mono text-muted-foreground/50 border border-border/30 px-2 py-0.5 rounded">
   477|   476|   476|                  ABD-2026
   478|   477|   477|                </div>
   479|   478|   478|
   480|   479|   479|                <CardContent className="p-5 sm:p-8 space-y-6">
   481|   480|   480|                  <div className="text-center space-y-2">
   482|   481|   481|                    <div className="inline-flex items-center gap-2 mb-2">
   483|   482|   482|                      <Shield className="h-5 w-5 text-primary" />
   484|   483|   483|                      <h3 className="text-2xl sm:text-3xl font-black">Tournament Entry</h3>
   485|   484|   484|                    </div>
   486|   485|   485|                    <p className="text-sm text-muted-foreground font-mono">
   487|   486|   486|                      // Secure your spot — first come, first served. Only {MAX_SPOTS} spots available.
   488|   487|   487|                    </p>
   489|   488|   488|                  </div>
